# Session encryption password (generate with `openssl rand -base64 32`)
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-byte-string

# SMTP server for sending reservation notification emails
NUXT_SMTP_HOST=smtp.example.com
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=user@example.com
NUXT_SMTP_PASS=change-me

# Email recipient for reservation notifications
NUXT_MAIL_TO=reservations@example.com

# Passwords used by the local dev seed script (server/db/seed.ts), not read by the app itself
SEED_ADMIN_PASSWORD=change-me
SEED_FAMILY_PASSWORD=change-me
SEED_DEMO_PASSWORD=demo
